# Supabase — Settings > API del tuo progetto.
VITE_SUPABASE_URL=https://<tuo-progetto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon/publishable key>

# Notifiche push — la chiave PUBBLICA della coppia VAPID (`npx web-push
# generate-vapid-keys`). La privata non sta qui: va solo nei secret di Supabase,
# insieme a questa (vedi supabase/functions/notifica/index.ts). Senza questa
# riga l'app funziona lo stesso, con le notifiche spente.
VITE_VAPID_PUBLIC_KEY=<chiave pubblica VAPID>
